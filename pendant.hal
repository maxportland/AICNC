# XHC-WHB04B-6 Wireless Pendant Configuration

# Load the pendant component
# -H = half-step mode for smoother jog wheel
loadusr -W xhc-whb04b-6 -H

# The WHB04B-6 driver has issues with jog-scale in continuous mode
# We'll set fixed jog velocities based on MAX_LINEAR_VELOCITY from INI
# Max velocity for X/Y is ~83mm/s, Z is ~16mm/s (from INI file)
# In continuous mode with 100% feed selector, we want reasonable jog speed

# Reuse existing axis-select signals from Mesa7I96S.hal
# Note: axis-select-x is commented out in Mesa7I96S.hal, so we create a new one for X
net axis-select-x       whb.halui.axis.x.select => halui.axis.x.select
net axis-select-y       whb.halui.axis.y.select => halui.axis.y.select
net axis-select-z       whb.halui.axis.z.select => halui.axis.z.select

net pdnt.axis.x.jog-scale whb.axis.x.jog-scale axis.x.jog-scale
net pdnt.axis.y.jog-scale whb.axis.y.jog-scale axis.y.jog-scale
net pdnt.axis.z.jog-scale whb.axis.z.jog-scale axis.z.jog-scale

net pdnt.axis.x.jog-counts whb.axis.x.jog-counts axis.x.jog-counts
net pdnt.axis.y.jog-counts whb.axis.y.jog-counts axis.y.jog-counts
net pdnt.axis.z.jog-counts whb.axis.z.jog-counts axis.z.jog-counts

net pdnt.axis.x.jog-enable whb.axis.x.jog-enable axis.x.jog-enable
net pdnt.axis.y.jog-enable whb.axis.y.jog-enable axis.y.jog-enable
net pdnt.axis.z.jog-enable whb.axis.z.jog-enable axis.z.jog-enable

net pdnt.axis.x.jog-vel-mode whb.axis.x.jog-vel-mode axis.x.jog-vel-mode
net pdnt.axis.y.jog-vel-mode whb.axis.y.jog-vel-mode axis.y.jog-vel-mode
net pdnt.axis.z.jog-vel-mode whb.axis.z.jog-vel-mode axis.z.jog-vel-mode

# Emergency Stop - the pendant's Stop button trips E-stop (stronger than program stop)
net pdnt.button.stop            whb.button.stop             => halui.estop.activate

# Program control  
net pdnt.button.start-pause     whb.button.start-pause      => halui.program.run
net pdnt.button.macro-10        whb.button.macro-10         => halui.program.pause

# Mode selection
net pdnt.button.macro-1         whb.button.macro-1          => halui.mode.manual
net pdnt.button.macro-2         whb.button.macro-2          => halui.mode.mdi  
net pdnt.button.macro-3         whb.button.macro-3          => halui.mode.auto

# Spindle control - use macro button instead
net pdnt.button.macro-4         whb.button.macro-4          => halui.spindle.0.start

# Feed override
net pdnt.button.feed-plus       whb.button.feed-plus        => halui.feed-override.increase
net pdnt.button.feed-minus      whb.button.feed-minus       => halui.feed-override.decrease

# Spindle override
net pdnt.button.spindle-plus    whb.button.spindle-plus     => halui.spindle.0.increase
net pdnt.button.spindle-minus   whb.button.spindle-minus    => halui.spindle.0.decrease

# Probe (if you have one)
#net pdnt.button.probe-z         whb.button.probe-z          => halui.mdi-command-00

# Machine home
net pdnt.button.macro-7         whb.button.macro-7          => halui.home-all

# Reset button
net pdnt.button.reset           whb.button.reset            => halui.estop.reset

# Mode status feedback to pendant LEDs (reuse existing signals)
net pdnt.led.mode-manual        halui.mode.is-manual        => whb.halui.mode.is-manual
net pdnt.led.mode-auto          halui.mode.is-auto          => whb.halui.mode.is-auto
net MDI-mode                                                => whb.halui.mode.is-mdi

# Spindle status feedback (reuse existing signal)
net spindle-enable                                          => whb.halui.spindle.is-on

# Machine status feedback (reuse existing signal)
net machine-is-on                                           => whb.halui.machine.is-on

# Position feedback to pendant display (use joint feedback directly)
net x-pos-fb                                                => whb.halui.axis.x.pos-feedback
net y-pos-fb                                                => whb.halui.axis.y.pos-feedback
net z-pos-fb                                                => whb.halui.axis.z.pos-feedback

# Program status to pendant
net pdnt.program.is-idle        halui.program.is-idle       => whb.halui.program.is-idle
net pdnt.program.is-running     halui.program.is-running    => whb.halui.program.is-running
net pdnt.program.is-paused      halui.program.is-paused     => whb.halui.program.is-paused

# Feed override feedback
net pdnt.feed-override          halui.feed-override.value   => whb.halui.feed-override.value

# Spindle override feedback (pin doesn't exist in this config)
#net pdnt.spindle-override       halui.spindle-override.value => whb.halui.spindle-override.value
